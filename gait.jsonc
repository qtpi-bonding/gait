{
  // gait configuration
  "model": "minimax/MiniMax-M1-80k",
  // Allow list: tools that run without approval in non-auto mode
  "allow": ["read", "glob", "grep", "ls", "codesearch", "output", "mcp", "skill"],
  // Tier 1 config-defined tools
  "tools": [
    { "name": "cargo_test", "description": "Run the full gait-rs test suite (codebase root is the rs-port dir, Cargo.toml is in gait-rs/ subfolder)", "cmd": "cd gait-rs && cargo test 2>&1 | tail -30", "cwd": "workspace" },
    { "name": "cargo_build", "description": "Build gait-rs in debug mode to check for compile errors", "cmd": "cd gait-rs && cargo build 2>&1 | grep -E '^error|^warning.*unused' | head -20", "cwd": "workspace" },
    { "name": "cargo_test_filter", "description": "Run tests by name filter. Usage: shell tool with cmd='cd gait-rs && cargo test <filter> 2>&1 | tail -20'", "cmd": "cd gait-rs && cargo test 2>&1 | tail -20", "cwd": "workspace" }
  ]
}
